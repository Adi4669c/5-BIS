import numpy as np
import matplotlib.pyplot as plt
from scipy.special import gamma

# Parameters (Matching the exact same setup)
AREA = 100
N = 40
R = 10
ITER = 100
POP = 20
PA = 0.25 # Probability of detecting a cuckoo's egg

def coverage(nodes):
    x = np.arange(0, AREA, 2)
    y = np.arange(0, AREA, 2)
    xx, yy = np.meshgrid(x, y)
    covered = np.zeros(xx.shape, dtype=bool)
    for sx, sy in nodes:
        covered |= (xx-sx)**2 + (yy-sy)**2 <= R**2
    return covered.mean()

def levy_flight(Lambda, size):
    """Generates a step size following Levy flight distribution using Mantegna's algorithm."""
    sigma = (gamma(1 + Lambda) * np.sin(np.pi * Lambda / 2) / 
             (gamma((1 + Lambda) / 2) * Lambda * 2**((Lambda - 1) / 2)))**(1 / Lambda)
    u = np.random.normal(0, sigma, size)
    v = np.random.normal(0, 1, size)
    step = u / (np.abs(v)**(1 / Lambda))
    return step

# Initialize population randomly
nests = [np.random.rand(N, 2) * AREA for _ in range(POP)]
fitness = [coverage(nest) for nest in nests]

best_idx = np.argmax(fitness)
best_nest = nests[best_idx].copy()
best_coverage = fitness[best_idx]
initial_coverage = best_coverage

csa_history = []

# Cuckoo Search Optimization Loop
for t in range(ITER):
    # 1. Generate new solutions (cuckoos) via Levy Flights
    for i in range(POP):
        step = levy_flight(1.5, (N, 2))
        # Use a scaling factor based on area size to allow exploration even when nests align
        step_size = 0.05 * step * (nests[i] - best_nest + np.random.uniform(-1, 1, (N, 2)))
        new_nest = nests[i] + step_size
        new_nest = np.clip(new_nest, 0, AREA)
        
        new_fit = coverage(new_nest)
        
        # Choose a random nest to potentially replace
        random_partner = np.random.randint(0, POP)
        if new_fit > fitness[random_partner]:
            nests[random_partner] = new_nest.copy()
            fitness[random_partner] = new_fit

    # 2. Abandon a fraction (PA) of worst nests
    for i in range(POP):
        if np.random.rand() < PA:
            # Ensure distinct random nests are picked to prevent self-subtraction to zero
            r1, r2 = np.random.choice(POP, 2, replace=False)
            step_size = np.random.rand() * (nests[r1] - nests[r2])
            new_nest = nests[i] + step_size
            new_nest = np.clip(new_nest, 0, AREA)
            
            new_fit = coverage(new_nest)
            if new_fit > fitness[i]:
                nests[i] = new_nest.copy()
                fitness[i] = new_fit

    # Track global best
    current_best_idx = np.argmax(fitness)
    if fitness[current_best_idx] > best_coverage:
        best_coverage = fitness[current_best_idx]
        best_nest = nests[current_best_idx].copy()
        
    csa_history.append(best_coverage)

# ---------------- TEXT OUTPUT ----------------
print("\n====================================")
print("      CUCKOO SEARCH WSN COVERAGE     ")
print("====================================")
print("Initial Coverage   :", round(initial_coverage * 100, 2), "%")
print("Final Coverage     :", round(best_coverage * 100, 2), "%")
print("Coverage Improvement:", round((best_coverage - initial_coverage) * 100, 2), "percentage points")
print("====================================")

# Plotting Results
plt.figure(figsize=(12, 5))

# Subplot 1: Sensor Placements
plt.subplot(1, 2, 1)
plt.scatter(best_nest[:, 0], best_nest[:, 1], s=25, color='red')
for x, y in best_nest:
    circle = plt.Circle((x, y), R, fill=False, color='blue', alpha=0.1)
    plt.gca().add_patch(circle)
plt.xlim(0, AREA)
plt.ylim(0, AREA)
plt.xlabel("X (m)")
plt.ylabel("Y (m)")
plt.title("Cuckoo Search Optimized Placement")
plt.grid(alpha=0.25)

# Subplot 2: Convergence Profile
plt.subplot(1, 2, 2)
plt.plot(np.array(csa_history) * 100, color='darkorange', linewidth=2)
plt.xlabel("Iteration")
plt.ylabel("Coverage (%)")
plt.title("Cuckoo Search Convergence Profile")
plt.grid(alpha=0.25)

plt.tight_layout()
plt.show()




